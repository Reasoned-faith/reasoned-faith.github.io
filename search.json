---
layout: null
permalink: /search.json
---
{%- include data.html -%}
{"a":[
{%- for p in arts -%}
{%- assign pt = p.path | split: "/" -%}
{%- assign cslug = pt[1] -%}
{%- capture cname %}{% include catname.html slug=cslug %}{% endcapture -%}
{%- assign sname = "" -%}{%- assign sslug = "" -%}
{%- if pt.size > 3 -%}{%- assign sslug = pt[2] -%}{%- capture sname %}{% include catname.html slug=sslug %}{% endcapture -%}{%- endif -%}
{%- capture body %}{{ p.content | markdownify | strip_html | normalize_whitespace | truncate: 20000, "" }}{% endcapture -%}
{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"cat":{{ cname | strip | jsonify }},"cs":{{ cslug | jsonify }},"sub":{{ sname | strip | jsonify }},"ss":{{ sslug | jsonify }},"excerpt":{{ p.excerpt | default: "" | strip_html | normalize_whitespace | jsonify }},"tags":{{ p.tags | jsonify }},"date":{{ p.date | date: "%-d %b %Y" | default: "" | jsonify }},"body":{{ body | strip | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
],"v":[
{%- for v in site.data.verses -%}
{"text":{{ v.text | jsonify }},"ref":{{ v.ref | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
],"t":[
{%- for t in site.data.topics -%}
{"title":{{ t.title | jsonify }},"desc":{{ t.description | default: "" | jsonify }},"q":{{ t.query | default: t.title | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
],"c":[
{%- assign first = true -%}
{%- for c in catlist -%}
{%- capture cname %}{% include catname.html slug=c %}{% endcapture -%}
{%- assign ck = c | replace: " ", "-" -%}
{%- assign pre = "articles/" | append: c | append: "/" -%}
{%- assign ca = arts | where_exp: "p", "p.path contains pre" -%}
{%- unless first %},{% endunless -%}{%- assign first = false -%}
{"name":{{ cname | strip | jsonify }},"desc":{{ site.data.categories[ck].description | default: "" | jsonify }},"url":{{ "/" | relative_url | append: "#" | append: c | jsonify }},"n":{{ ca.size }},"parent":""}
{%- assign subs = "" -%}
{%- for p in ca -%}{%- assign pt = p.path | split: "/" -%}{%- if pt.size > 3 -%}{%- assign subs = subs | append: pt[2] | append: "," -%}{%- endif -%}{%- endfor -%}
{%- assign sublist = subs | split: "," | uniq -%}
{%- for sl in sublist -%}
{%- capture sn %}{% include catname.html slug=sl %}{% endcapture -%}
{%- assign spre = pre | append: sl | append: "/" -%}
{%- assign sa = ca | where_exp: "p", "p.path contains spre" -%}
,{"name":{{ sn | strip | jsonify }},"desc":"","url":{{ "/" | relative_url | append: "#" | append: c | append: "/" | append: sl | jsonify }},"n":{{ sa.size }},"parent":{{ cname | strip | jsonify }}}
{%- endfor -%}
{%- endfor -%}
]}
