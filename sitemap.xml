---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
{%- unless p.url contains '.' or p.sitemap == false %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
{%- endunless -%}
{%- endfor -%}
{%- for a in site.articles %}
  <url><loc>{{ a.url | absolute_url }}</loc><lastmod>{{ a.updated | default: a.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
